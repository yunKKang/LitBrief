[Unit]
Description=LitBrief weekly verified publication
After=network-online.target litbrief-discover.service
Wants=network-online.target

[Service]
Type=oneshot
User=litbrief
Group=litbrief
WorkingDirectory=/opt/litbrief
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 scripts/scheduled_run.py weekly
UMask=0077
TimeoutStartSec=12h
MemoryMax=512M
CPUQuota=50%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/litbrief/outputs /var/www/litbrief
